# ========================================
# Frontend Environment Variables
# ========================================
# Copy this file to .env and update with your actual values

# ========================================
# Backend API Configuration
# ========================================
# API Base URL
VITE_BASE_URL=http://localhost:8080/api/v1

# WebSocket URL (MUST include /ws at the end)
VITE_BACKEND_WS_URL=http://localhost:8080/ws

# Alternative WebSocket URL name
# VITE_WS_URL=http://localhost:8080/ws

# For Docker (Frontend container → Backend container)
# VITE_BASE_URL=http://backend:8080/api/v1
# VITE_WS_URL=http://backend:8080/ws

# ========================================
# OAuth Configuration
# ========================================
# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Facebook App ID
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# ========================================
# Cloudinary Configuration (Optional)
# ========================================
# Currently not used - Backend handles file uploads
# Uncomment if you want to upload directly from frontend
# VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your-cloud-name/image/upload
# VITE_CLOUDINARY_PRESET=your-upload-preset
