# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True

# Cloudflare Workers AI (miễn phí 10,000 neurons/ngày)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/elearning_chatbot
# Hoặc dùng chung DB với Spring Boot
# DATABASE_URL=postgresql://postgres:password@localhost:5432/elearning

# Spring Boot Backend
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_API_KEY=your_api_key_here

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chatbot Configuration
MAX_CONVERSATION_HISTORY=10
MAX_TOKENS=1000
TEMPERATURE=0.7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
