# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True

# AI Provider Keys (chọn ít nhất 1)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Default AI Provider (openai, gemini, or anthropic)
DEFAULT_AI_PROVIDER=gemini

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/elearning_chatbot
# Hoặc dùng chung DB với Spring Boot
# DATABASE_URL=postgresql://postgres:password@localhost:5432/elearning

# Spring Boot Backend
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_API_KEY=your_api_key_here

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chatbot Configuration
MAX_CONVERSATION_HISTORY=10
MAX_TOKENS=1000
TEMPERATURE=0.7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
