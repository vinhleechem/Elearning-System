# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/elearning
DB_USERNAME=postgres
DB_PASSWORD=your-password-here

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-long

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# VNPay Payment Configuration
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_SECRET_KEY=your-vnpay-secret-key
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# OAuth Configuration (Optional)
OUTBOUND_IDENTITY_CLIENT_ID=your-client-id
OUTBOUND_IDENTITY_CLIENT_SECRET=your-client-secret
OUTBOUND_IDENTITY_REDIRECT_URI=http://localhost:3000/auth/callback

OUTBOUND_FACEBOOK_CLIENT_ID=
OUTBOUND_FACEBOOK_CLIENT_SECRET=
OUTBOUND_FACEBOOK_REDIRECT_URI=
